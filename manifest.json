{
  "manifest_version": 3,
  "name": "YTM-Immersion",
  "version": "2.0.2",
  "description": "YouTube Musicをもっと美しく",
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://music.youtube.com/*",
    "https://lrclib.net/*",
    "https://lyricsplus-seven.vercel.app/*",
    "https://lyricsplus.prjktla.workers.dev/*",
    "https://lyricsplus.prjktla.my.id/*",
    "https://api-lyrics.simpmusic.org/*",
    "https://lrchub.coreone.work/*",
    "https://api-free.deepl.com/*",
    "https://api.deepl.com/*"
  ],
  "background": {
    "service_worker": "src/js/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://music.youtube.com/*"
      ],
      "js": [
        "src/js/module/namespace.js",
        "src/js/module/cloud-sync.js",
        "src/js/module/lyrics-cache.js",
        "src/js/module/replay-manager.js",
        "src/js/module/queue-manager.js",
        "src/js/module/pip-manager.js",
        "src/js/module/ytm-lyrics.js",
        "src/js/module/lyrics-ui.js",
        "src/js/content.js"
      ],
      "css": [
        "src/css/style.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/assets/fonts/*.woff2",
        "src/assets/icons/*.png"
      ],
      "matches": [
        "https://music.youtube.com/*"
      ]
    }
  ],
  "icons": {
    "16": "src/assets/icons/icon16.png",
    "48": "src/assets/icons/icon48.png",
    "128": "src/assets/icons/icon128.png"
  }
}
